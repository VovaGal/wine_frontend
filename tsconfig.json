{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": false, // NOTE: For development only, in production set this to true
        "noUnusedParameters": false, // NOTE: For development only, in production set this to true
        "noFallthroughCasesInSwitch": true,
        "types": [
            "vite/client"
        ]
    },
    "useDefineForClassFields": true,
    "include": [
        "src",
        "vite.config.ts"
    ]
}